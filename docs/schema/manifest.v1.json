{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gray.alignment.id/schema/manifest.v1.json",
  "title": "gray sidecar plugin/manifest result (protocol v1.1 + v1.2 additions)",
  "type": "object",
  "required": ["name", "version", "tools"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "tools": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string", "description": "pre-v1 bare tool name"},
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "parameters": {"type": "object"},
              "snippet": {"type": "string"}
            }
          }
        ]
      }
    },
    "commands": {"type": "array", "items": {"type": "string", "pattern": "^/"}},
    "hooks": {
      "type": "array",
      "items": {"type": "string", "enum": ["prompt/context", "tool/before", "turn/end"]}
    },
    "provider": {"type": "string"},
    "protocol": {"type": "string", "enum": ["1.1"]},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "enum": ["exec", "http", "session", "ui"]}
    },
    "subcommands": {"type": "array", "items": {"type": "string", "pattern": "^/"}}
  }
}
